#!/bin/bash

set -euo pipefail

GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'

# Check if production or staging
production=false
while getopts 'p' opt; do
  case "$opt" in
    p) production=true ;;
  esac
done
shift "$((OPTIND - 1))"

configuration="staging"
if [[ "$production" == true ]]; then
  configuration="production"
fi

# Read version from package.json
version=$(node -p "require('./package.json').version")

# Temporarily update index.html
cp src/index.html src/index.html.bak
trap 'mv -f src/index.html.bak src/index.html' EXIT

sed -i "s/{{ VERSION }}/$version/g" src/index.html

# Generate bundle
echo "${GREEN}»»» Generating $configuration bundle (v$version) «««${NC}"

rm -rf dist/keystone-registration
npx ng build --configuration "$configuration"

# Clean up the remote playground folder
# remote="climbdal@keystone-adventures.com"
remote="raul@keystone-adventures.cn"
echo "\n${GREEN}»»» Cleaning remote directories «««${NC}\n"
echo "    » Local system name: $HOSTNAME"
echo "    » Local date and time: $(date)"

if [[ "$production" = true ]]
then
  echo "\n${GREEN}»»» Running commands on remote host named $remote:program «««${NC}\n"
  ssh -T $remote <<'EOL'
	now="$(date)"
	name="$HOSTNAME"
	up="$(uptime)"
	echo "    » Server name is $name"
	echo "    » Server date and time is $now"
	echo "    » Server uptime: $up"
	cd program
  rm -rf *
	echo "Bye"
EOL
else
  echo "\n${GREEN}»»» Running commands on remote host named $remote folder 'public_html/registration' «««${NC}\n"
  ssh -T $remote <<'EOL'
	now="$(date)"
	name="$HOSTNAME"
	up="$(uptime)"
	echo "    » Server name is $name"
	echo "    » Server date and time is $now"
	echo "    » Server uptime: $up"
	cd public_html/registration
	rm *.js manifest.* ngsw.json *.css index.html favicon.ico
  [ ! -e *.map ] || rm *.map
  rm -rf assets/
	echo "Bye"
EOL
fi

# Publish to the correct subdomain
echo "\n${GREEN}»»» Publishing $configuration bundle to $remote:program «««${NC}\n"
rsync -azvh dist/keystone-registration/browser/ $remote:program/
